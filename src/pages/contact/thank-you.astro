---
import Base from '../../layouts/Base.astro';
import { SITE } from '../../site';
---
<Base title="Thanks, we've got your message" description="Thanks for getting in touch." noindex>
  <section class="hero page-hero">
    <div class="wrap">
      <span class="mono eyebrow">Message sent</span>
      <h1>Thanks, we've got it.</h1>
      <p class="sub">We'll get back to you about the job. If it's urgent, call {SITE.phone}.</p>
      <div class="ctas"><a class="btn btn-ghost" href="/">Back to the home page</a></div>
    </div>
  </section>
</Base>
